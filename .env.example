# Copy to `.env` and fill in. Never commit `.env`.

# --- TMDB (free key: https://www.themoviedb.org/settings/api) ---
# Paste the "API Read Access Token" (long JWT, preferred) or the short "API Key (v3)".
TMDB_API_KEY=
TMDB_REGION=FR
TMDB_LANGUAGE=en-US
# requests per second (TMDB allows ~50/s; stay well under)
TMDB_RATE_LIMIT=30

# --- Database ---
POSTGRES_USER=cinegraph
POSTGRES_PASSWORD=cinegraph
POSTGRES_DB=cinegraph
# used by the backend; inside docker compose this is overridden to host "db"
DATABASE_URL=postgresql://cinegraph:cinegraph@127.0.0.1:5433/cinegraph

# --- Letterboxd (official routes only: export ZIP, public RSS, CSV import) ---
LETTERBOXD_USERNAME=polluxgnr
RSS_POLL_MINUTES=30

# --- MovieLens (GroupLens, personal/research use only) ---
# ml-latest-small (1 MB, quick) or ml-32m (240 MB, full CF signal)
MOVIELENS_VARIANT=ml-latest-small

# --- Wikidata: its User-Agent policy needs a contact URL or e-mail.
# Empty = your public Letterboxd profile URL.
WIKIDATA_CONTACT=

# --- Embeddings: fastembed (ONNX, downloads ~130 MB model once) or lsa (offline TF-IDF+SVD) ---
EMBEDDER=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- LLM rerank / natural-language queries ---
# anthropic | openai_compat | ollama | none
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# for openai_compat / ollama
LLM_BASE_URL=
LLM_API_KEY=

# --- Your taste / platforms ---
# Netflix, Prime Video, Disney+, HBO Max, Canal+, Apple TV+
MY_PLATFORMS=Netflix,Prime Video,Disney+,HBO Max,Canal+,Apple TV+

# --- Scheduler (worker container) ---
NIGHTLY_RETRAIN_HOUR=4
